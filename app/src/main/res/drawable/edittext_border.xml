<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Цвет фона (можно сделать прозрачным или любым другим) -->
    <solid android:color="@android:color/transparent" />

    <corners android:radius="8dp" />

    <!-- Цвет и толщина рамки -->
    <stroke
        android:width="1dp"
        android:color="@color/active_color" />

    <!-- Отступы внутри EditText -->
    <padding
        android:bottom="13dp"
        android:left="12dp"
        android:right="12dp"
        android:top="13dp" />
</shape>