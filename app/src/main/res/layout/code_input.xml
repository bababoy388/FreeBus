<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_input_code"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Введите номер маршрута и номер автобуса"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Пример: 85 а192ау124"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        android:textColor="@color/inactive_color"/>

    <EditText
        android:id="@+id/editTextCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textColorHint="@color/active_color"
        android:hint="Введите код"
        android:backgroundTint="@color/white"
        android:background="@drawable/edittext_border"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:gravity="end">

        <!-- Кнопка "Назад" без рамки - теперь рядом с ОК -->
        <TextView
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp"
            android:text="Назад"
            android:textColor="@color/active_color"
            android:textSize="18sp"
            android:layout_marginEnd="16dp"/>

        <!-- Круглая кнопка "ОК" -->
        <TextView
            android:id="@+id/buttonSubmit"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="OK"
            android:textSize="18sp"
            android:gravity="center"
            android:textColor="@color/white"
            android:background="@drawable/button_round"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</LinearLayout>