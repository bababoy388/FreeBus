<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Введите цифровой код"
        android:textColor="@color/standart_text_color"
        android:textSize="20sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Напечатан на наклейке в транспорте"
        android:textSize="14dp"
        android:layout_marginBottom="16dp"
        android:textColor="@color/inactive_color"/>

    <EditText
        android:id="@+id/editTextCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textColorHint="@color/active_color"
        android:hint="Введите код"
        android:backgroundTint="@color/active_color"
        android:background="@drawable/edittext_border"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical">

        <!-- QR элемент слева -->
        <LinearLayout
            android:id="@+id/qrContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/qr_icon"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/qrButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR"
                android:textSize="16sp"
                android:textColor="@color/active_color"/>
        </LinearLayout>

        <!-- Кнопки справа -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <TextView
                android:id="@+id/buttonBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:text="ОТМЕНА"
                android:textColor="@color/active_color"
                android:textSize="16sp"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/buttonSubmit"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="OK"
                android:textSize="16sp"
                android:gravity="center"
                android:textColor="@color/standart_text_color"
                android:background="@drawable/button_round"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>