<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Градиентная "челка" (1/4 экрана) - прижата к верху и краям -->
    <View
        android:id="@+id/upper_menu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/gradient_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHeight_percent="0.25" />

    <TextView
        android:id="@+id/text_on_image1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="108dp"
        android:text="zagrobinger312@gmail.com"
        android:textColor="@color/standart_text_color"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/upper_menu"
        app:layout_constraintTop_toTopOf="@id/upper_menu" />

    <TextView
        android:id="@+id/text_on_image2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/oval_border"
        android:drawableStart="@drawable/location"
        android:drawablePadding="4dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="Красноярский край"
        android:textColor="@color/standart_text_color"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/upper_menu"
        app:layout_constraintTop_toBottomOf="@id/text_on_image1" />

    <ImageView
        android:id="@+id/icon_on_image"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/info"
        android:tint="@color/white"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintEnd_toEndOf="@id/upper_menu"
        app:layout_constraintBottom_toBottomOf="@id/upper_menu" />

    <!-- Контейнер для меню с отступами -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/upper_menu">

        <!-- Первая строка меню -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/settings_icon" />

            <TextView
                android:id="@+id/text1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Настройки"
                android:textColor="@color/standart_text_color"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Вторая строка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/about_info_icon" />

            <TextView
                android:id="@+id/text2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="О приложении"
                android:textColor="@color/standart_text_color"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Третья строка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon3"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/rules_icon" />

            <TextView
                android:id="@+id/text3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Пользовательское соглашение"
                android:textColor="@color/standart_text_color"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Четвертая строка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon4"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/exit_icon" />

            <TextView
                android:id="@+id/text4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Выйти"
                android:textColor="@color/standart_text_color"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>