<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ticket_background_dark">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ticketArea"
        android:layout_width="400dp"
        android:layout_height="700dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.454"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <!-- ВЕРТИКАЛЬНЫЕ Guidelines ДЛЯ ОТСТУПОВ СЛЕВА/СПРАВА -->

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_33"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.83" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.05" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_85"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.95" />

        <!-- ГОРИЗОНТАЛЬНЫЕ Guidelines ДЛЯ 5 БИЛЕТОВ -->

        <!-- Guideline для первого билета -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_ticket1_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.05" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_ticket1_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.20" />

        <!-- Guideline для второго билета -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_ticket2_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.20" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_ticket2_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.35" />

        <!-- Guideline для третьего билета -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_ticket3_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.35" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_ticket3_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.50" />

        <!-- Guideline для четвертого билета -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_ticket4_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.50" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_ticket4_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.65" />

        <!-- Guideline для пятого билета -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_ticket5_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.65" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_ticket5_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.80" />

        <!-- НАДПИСИ С ДАТАМИ НАД КАЖДЫМ БИЛЕТОМ -->

        <!-- Дата для первого билета -->
        <TextView
            android:id="@+id/tvDate1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="7 февраля"
            android:textColor="#BFBFBF"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/guideline_85"
            app:layout_constraintStart_toStartOf="@id/guideline_5"
            app:layout_constraintTop_toTopOf="@id/guideline_ticket1_top" />

        <!-- Дата для второго билета -->
        <TextView
            android:id="@+id/tvDate2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="5 февраля"
            android:textColor="#BFBFBF"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/guideline_85"
            app:layout_constraintStart_toStartOf="@id/guideline_5"
            app:layout_constraintTop_toTopOf="@id/guideline_ticket2_top" />

        <!-- Дата для третьего билета -->
        <TextView
            android:id="@+id/tvDate3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="4 февраля"
            android:textColor="#BFBFBF"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/guideline_85"
            app:layout_constraintStart_toStartOf="@id/guideline_5"
            app:layout_constraintTop_toTopOf="@id/guideline_ticket3_top" />

        <!-- Дата для четвертого билета -->
        <TextView
            android:id="@+id/tvDate4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="2 февраля"
            android:textColor="#BFBFBF"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/guideline_85"
            app:layout_constraintStart_toStartOf="@id/guideline_5"
            app:layout_constraintTop_toTopOf="@id/guideline_ticket4_top" />

        <!-- Дата для пятого билета -->
        <TextView
            android:id="@+id/tvDate5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="1 февраля"
            android:textColor="#BFBFBF"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/guideline_85"
            app:layout_constraintStart_toStartOf="@id/guideline_5"
            app:layout_constraintTop_toTopOf="@id/guideline_ticket5_top" />

        <!-- БИЛЕТ 1 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/ticket1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="8dp"
            app:cardBackgroundColor="#540D0D"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:layout_constraintBottom_toTopOf="@id/guideline_ticket1_bottom"
            app:layout_constraintEnd_toStartOf="@id/guideline_85"
            app:layout_constraintStart_toStartOf="@id/guideline_5"
            app:layout_constraintTop_toBottomOf="@id/tvDate1">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background_input_code"
                android:padding="12dp">

                <!-- Иконка билета слева -->
                <ImageView
                    android:id="@+id/ivTicketIcon1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ticket_info_icon"
                    android:tint="@color/lavande"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Количество билетов справа -->
                <TextView
                    android:id="@+id/tvCount1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 шт"
                    android:textColor="@color/standart_text_color"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Номер автобуса (первая строка) -->
                <TextView
                    android:id="@+id/tvBusNumber1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Автобус №85"
                    android:textColor="@color/standart_text_color"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvCount1"
                    app:layout_constraintStart_toEndOf="@id/ivTicketIcon1"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Время покупки (вторая строка) -->
                <TextView
                    android:id="@+id/tvPurchaseTime1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="06:28:54"
                    android:textColor="#BFBFBF"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvCount1"
                    app:layout_constraintStart_toEndOf="@id/ivTicketIcon1"
                    app:layout_constraintTop_toBottomOf="@id/tvBusNumber1" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- БИЛЕТ 2 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/ticket2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:layout_constraintBottom_toTopOf="@id/guideline_ticket2_bottom"
            app:layout_constraintEnd_toStartOf="@id/guideline_85"
            app:layout_constraintStart_toStartOf="@id/guideline_5"
            app:layout_constraintTop_toBottomOf="@id/tvDate2">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background_input_code"
                android:padding="12dp">

                <!-- Иконка билета слева -->
                <ImageView
                    android:id="@+id/ivTicketIcon2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ticket_info_icon"
                    android:tint="@color/lavande"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Количество билетов справа -->
                <TextView
                    android:id="@+id/tvCount2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 шт"
                    android:textColor="@color/standart_text_color"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Номер автобуса (первая строка) -->
                <TextView
                    android:id="@+id/tvBusNumber2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Автобус №85"
                    android:textColor="@color/standart_text_color"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvCount2"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@id/ivTicketIcon2"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Время покупки (вторая строка) -->
                <TextView
                    android:id="@+id/tvPurchaseTime2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="06:43:34"
                    android:textColor="#BFBFBF"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvCount2"
                    app:layout_constraintStart_toEndOf="@id/ivTicketIcon2"
                    app:layout_constraintTop_toBottomOf="@id/tvBusNumber2" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- БИЛЕТ 3 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/ticket3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:layout_constraintBottom_toTopOf="@id/guideline_ticket3_bottom"
            app:layout_constraintEnd_toStartOf="@id/guideline_85"
            app:layout_constraintStart_toStartOf="@id/guideline_5"
            app:layout_constraintTop_toBottomOf="@id/tvDate3">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background_input_code"
                android:padding="12dp">

                <!-- Иконка билета слева -->
                <ImageView
                    android:id="@+id/ivTicketIcon3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ticket_info_icon"
                    android:tint="@color/lavande"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Количество билетов справа -->
                <TextView
                    android:id="@+id/tvCount3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 шт"
                    android:textColor="@color/standart_text_color"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Номер автобуса (первая строка) -->
                <TextView
                    android:id="@+id/tvBusNumber3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Автобус №9"
                    android:textColor="@color/standart_text_color"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvCount3"
                    app:layout_constraintStart_toEndOf="@id/ivTicketIcon3"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Время покупки (вторая строка) -->
                <TextView
                    android:id="@+id/tvPurchaseTime3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="18:31:51"
                    android:textColor="#BFBFBF"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvCount3"
                    app:layout_constraintStart_toEndOf="@id/ivTicketIcon3"
                    app:layout_constraintTop_toBottomOf="@id/tvBusNumber3" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- БИЛЕТ 4 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/ticket4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:layout_constraintBottom_toTopOf="@id/guideline_ticket4_bottom"
            app:layout_constraintEnd_toStartOf="@id/guideline_85"
            app:layout_constraintStart_toStartOf="@id/guideline_5"
            app:layout_constraintTop_toBottomOf="@id/tvDate4">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background_input_code"
                android:padding="12dp">

                <!-- Иконка билета слева -->
                <ImageView
                    android:id="@+id/ivTicketIcon4"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ticket_info_icon"
                    android:tint="@color/lavande"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Количество билетов справа -->
                <TextView
                    android:id="@+id/tvCount4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 шт"
                    android:textColor="@color/standart_text_color"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Номер автобуса (первая строка) -->
                <TextView
                    android:id="@+id/tvBusNumber4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Автобус №1"
                    android:textColor="@color/standart_text_color"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvCount4"
                    app:layout_constraintStart_toEndOf="@id/ivTicketIcon4"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Время покупки (вторая строка) -->
                <TextView
                    android:id="@+id/tvPurchaseTime4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="13:02:03"
                    android:textColor="#BFBFBF"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvCount4"
                    app:layout_constraintStart_toEndOf="@id/ivTicketIcon4"
                    app:layout_constraintTop_toBottomOf="@id/tvBusNumber4" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- БИЛЕТ 5 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/ticket5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:layout_constraintBottom_toTopOf="@id/guideline_ticket5_bottom"
            app:layout_constraintEnd_toStartOf="@id/guideline_85"
            app:layout_constraintStart_toStartOf="@id/guideline_5"
            app:layout_constraintTop_toBottomOf="@id/tvDate5">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background_input_code"
                android:padding="12dp">

                <!-- Иконка билета слева -->
                <ImageView
                    android:id="@+id/ivTicketIcon5"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ticket_info_icon"
                    android:tint="@color/lavande"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Количество билетов справа -->
                <TextView
                    android:id="@+id/tvCount5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 шт"
                    android:textColor="@color/standart_text_color"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Номер автобуса (первая строка) -->
                <TextView
                    android:id="@+id/tvBusNumber5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Автобус №9"
                    android:textColor="@color/standart_text_color"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvCount5"
                    app:layout_constraintStart_toEndOf="@id/ivTicketIcon5"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Время покупки (вторая строка) -->
                <TextView
                    android:id="@+id/tvPurchaseTime5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="21:53:27"
                    android:textColor="#BFBFBF"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvCount5"
                    app:layout_constraintStart_toEndOf="@id/ivTicketIcon5"
                    app:layout_constraintTop_toBottomOf="@id/tvBusNumber5" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>


    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/gradient_button"
        android:minHeight="49dp"
        android:text="КУПИТЬ БИЛЕТ"
        android:textColor="@color/standart_text_color"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>