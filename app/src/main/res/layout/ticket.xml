<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ticketArea"
        android:layout_width="350dp"
        android:layout_height="450dp"
        android:background="@drawable/ticket_templates"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="2:3">

        <!-- ВЕРТИКАЛЬНЫЕ Guidelines ДЛЯ ОТСТУПОВ СЛЕВА/СПРАВА -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.15" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_31"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.14" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_32"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.84" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_33"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.83" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.12" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.95" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_85"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.85" />

        <!-- ГОРИЗОНТАЛЬНЫЕ Guidelines ДЛЯ ПОЗИЦИОНИРОВАНИЯ ПО ВЫСОТЕ -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.009" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top_25"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.10" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top_35"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.25" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top_50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.35" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top_60"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.50" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top_61"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.60" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top_75"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.70" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top_85"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.80" />

        <!-- Тексты привязаны к направляющим -->
        <TextView
            android:id="@+id/dateText"
            android:layout_width="130dp"
            android:layout_height="35dp"
            android:text="17 января"
            android:textColor="@color/white"
            android:autoSizeTextType="uniform"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeMinTextSize="10sp"
            android:gravity="center"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@id/guideline_20"
            app:layout_constraintTop_toTopOf="@id/guideline_top_10" />

        <TextView
            android:id="@+id/timeText"
            android:layout_width="65dp"
            android:layout_height="35dp"
            android:text="19:34"
            android:textColor="@color/white"
            android:autoSizeTextType="uniform"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeMinTextSize="10sp"
            android:gravity="center"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="@id/guideline_5"
            app:layout_constraintTop_toTopOf="@id/guideline_top_10" />

        <TextView
            android:id="@+id/minutesText"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:text="15"
            android:textColor="@color/white"
            android:autoSizeTextType="uniform"
            android:autoSizeMaxTextSize="55sp"
            android:autoSizeMinTextSize="40sp"
            android:gravity="center"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="@id/guideline_15"
            app:layout_constraintTop_toTopOf="@id/guideline_top_25" />

        <TextView
            android:id="@+id/minutesLabel"
            android:layout_width="80dp"
            android:layout_height="25dp"
            android:text="Минуты"
            android:textColor="@color/white"
            android:autoSizeTextType="uniform"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeMinTextSize="10sp"
            android:gravity="center"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="@id/guideline_31"
            app:layout_constraintTop_toTopOf="@id/guideline_top_35" />

        <TextView
            android:id="@+id/secondsText"
            android:layout_width="79dp"
            android:layout_height="79dp"
            android:text="45"
            android:textColor="@color/white"
            android:autoSizeTextType="uniform"
            android:autoSizeMaxTextSize="55sp"
            android:autoSizeMinTextSize="30sp"
            android:gravity="center"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@id/guideline_33"
            app:layout_constraintTop_toTopOf="@id/guideline_top_25" />

        <TextView
            android:id="@+id/secondsLabel"
            android:layout_width="84dp"
            android:layout_height="25dp"
            android:text="Секунды"
            android:textColor="@color/white"
            android:autoSizeTextType="uniform"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeMinTextSize="10sp"
            android:gravity="center"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@id/guideline_32"
            app:layout_constraintTop_toTopOf="@id/guideline_top_35" />

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="50dp"
            app:cardBackgroundColor="#40D897ED"
            app:layout_constraintEnd_toStartOf="@id/guideline_85"
            app:layout_constraintStart_toStartOf="@id/guideline_15"
            app:layout_constraintTop_toTopOf="@id/guideline_top_50">

        <TextView
            android:id="@+id/routeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Залупино - Пидорасино fffffаааа"
            android:textColor="@color/white"
            android:textSize="18dp"
            android:gravity="center"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:ellipsize="end" />

    </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/guideline_top_60">

            <TextView
                android:id="@+id/priceText"
                android:layout_width="130dp"
                android:layout_height="40dp"
                android:autoSizeMaxTextSize="25sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:text="1 билет - 48₽"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/anotherText"
                android:layout_width="45dp"
                android:layout_height="20dp"
                android:text="Багаж"
                android:textColor="#80D897ED"
                android:autoSizeTextType="uniform"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="10sp"
                android:gravity="center"
                android:maxLines="1"
                android:background="@drawable/bagaj"
                android:layout_marginStart="1dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/companyText"
            android:layout_width="150dp"
            android:layout_height="35dp"
            android:text="ООО 'ГЫР-ГЫР'"
            android:textColor="@color/inactive_color"
            android:autoSizeTextType="uniform"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeMinTextSize="10sp"
            android:gravity="center"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/guideline_top_61" />

        <TextView
            android:id="@+id/busNumber"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:text="Л 833 ОХ 124"
            android:textColor="@color/white"
            android:autoSizeTextType="uniform"
            android:autoSizeMaxTextSize="35sp"
            android:autoSizeMinTextSize="10sp"
            android:gravity="center"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/guideline_top_75" />

        <TextView
            android:id="@+id/routeNumber"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:layout_marginTop="4dp"
            android:autoSizeMaxTextSize="35sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:text="№52"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/guideline_top_85" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>